# =================================================================================================
# This script builds the Docker container for the ROS 2 Benchmarking Suite.
# It supports multiple ROS 2 distributions and allows specifying the build target.
#
# Usage:
#   ./build_benchmark_container.sh [ROS_DISTRO] [CONTAINER_BUILD_TARGET]
# =================================================================================================

# Supported ROS 2 distributions
usage() {
  echo "Usage: $0 [-d <ros_distro>] [-a <architecture>]"
  exit 1
}
SUPPORTED_DISTROS=("jazzy" "kilted" "rolling")
# The ROS distribution to build the container for (default is "jazzy")
ROS_DISTRO="jazzy"
ARCH="$(dpkg --print-architecture)"

while [[ $# -gt 0 ]]; do
  key="$1"
  case $key in 
  -d | --distro)
    ROS_DISTRO="$2"
    shift 2
    ;;
  -a | --architecture)
    ARCH="$2"
    shift 2
    ;;
  *)
    echo "Unknown option: $key"
    usage
    ;;
  esac

done


if [[ ! "${SUPPORTED_DISTROS[@]}" =~ "${ROS_DISTRO}" ]]; then
    echo "ERROR: Unsupported ROS 2 distribution: '${ROS_DISTRO}'"
    echo "Supported distributions are: ${SUPPORTED_DISTROS[*]}. Default to 'jazzy'."
    exit 1
fi

# Export the ROS_DISTRO variable for docker-bake.hcl
export DISTRO="${ROS_DISTRO}"

# The build target to use from docker-bake.hcl (default is "default")
CONTAINER_BUILD_TARGET="${ARCH}"

THIS_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null && pwd )"
PARENT_DIR=$(dirname "${THIS_DIR}")
cd "$PARENT_DIR"

echo "Building ROS 2 Benchmark Container for ROS ${ROS_DISTRO}."
docker buildx bake ${CONTAINER_BUILD_TARGET} --load