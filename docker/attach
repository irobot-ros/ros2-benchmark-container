# =================================================================================================
# This script allows for easy attachment to a running benchmark container.
# Usage:
# From the root of this repo,
#   docker/attach <CONTAINER_PATTERN>
# =================================================================================================

CONTAINER_PATTERN=$1

# Get the container ID
CONTAINER=$(docker container ls | grep -E ${CONTAINER_PATTERN} | awk '{print $1}')

# Execute the entrypoint script inside the container
docker container exec -it "$CONTAINER" /bin/bash